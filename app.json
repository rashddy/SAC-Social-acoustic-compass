{
  "expo": {
    "name": "Social Acoustic Compass",
    "slug": "social-acoustic-compass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "socialacousticcompass",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Social Acoustic Compass uses Bluetooth to connect to your SAC wearable devices for spatial speech awareness.",
        "NSBluetoothPeripheralUsageDescription": "Social Acoustic Compass uses Bluetooth to connect to your SAC wearable devices.",
        "NSFaceIDUsageDescription": "Social Acoustic Compass uses Face ID to unlock saved conversations on this device."
      }
    },
    "android": {
      "package": "ph.edu.wmsu.ccs.sac",
      "adaptiveIcon": {
        "backgroundColor": "#080C14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
        "predictiveBackGestureEnabled": false,
        "allowBackup": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-file-system",
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Social Acoustic Compass uses Face ID to unlock saved conversations on this device.",
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Social Acoustic Compass uses Face ID to unlock saved conversations on this device."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Social Acoustic Compass connects to the SAC-Necklace and SAC-Wristband over Bluetooth Low Energy to receive speaker direction and send haptic commands."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080C14",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a79c9dce-b5b3-4399-81b8-ed28a75f868f"
      }
    },
    "owner": "rashdddy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a79c9dce-b5b3-4399-81b8-ed28a75f868f"
    }
  }
}
